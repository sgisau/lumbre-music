# Base de datos PostgreSQL (local o Neon/Vercel Postgres en producción)
DATABASE_URL=postgres://usuario:contraseña@127.0.0.1:5432/lumbre

# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Dirección pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zona horaria en que se muestran las horas de los eventos
SITE_TIMEZONE=America/Mexico_City

# Solo en producción: almacenamiento de imágenes en Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Solo en producción: protege el cron que publica lanzamientos programados
CRON_SECRET=
